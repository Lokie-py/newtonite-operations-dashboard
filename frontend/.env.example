# API Base URL for the FastAPI Backend
VITE_API_BASE_URL=http://localhost:8000

# Enable mock data adapter when backend is not running or during local evaluation
# Set to 'false' to route all traffic to the real FastAPI backend
VITE_USE_MOCK_DATA=true

# Mock API artificial network latency in milliseconds (0-1000)
VITE_MOCK_LATENCY=200

# App title and version
VITE_APP_TITLE="Newtonite Operations Dashboard"
VITE_APP_VERSION="1.0.0"
